		}
		if(this.isDead) {
			return;
		}
		if(this.isAnimationFinished() && !StringTools.endsWith(this.getCurrentAnimation(),funkin_util_Constants.ANIMATION_HOLD_SUFFIX) && this.hasAnimation(this.getCurrentAnimation() + funkin_util_Constants.ANIMATION_HOLD_SUFFIX)) {
			this.playAnimation(this.getCurrentAnimation() + funkin_util_Constants.ANIMATION_HOLD_SUFFIX);
