		if(stepNote.type == funkin_data_song_importer_StepManiaNoteType.Head || stepNote.type == funkin_data_song_importer_StepManiaNoteType.Roll) {
			holdArray[stepNote.column] = time;
			continue;
		}
		var snd = funkin_data_song_SongNoteData._new(time,stepNote.column,0);
		if(stepNote.type == funkin_data_song_importer_StepManiaNoteType.Mine) {
			snd.set_kind("mine");
		} else if(stepNote.type == funkin_data_song_importer_StepManiaNoteType.Fake) {
			snd.set_kind("fake");
		}
		if(stepNote.type == funkin_data_song_importer_StepManiaNoteType.Tail) {
			var length = 0;
			if(holdArray[stepNote.column] != -1) {
				length = time - holdArray[stepNote.column];
			}
			snd.set_time(holdArray[stepNote.column]);
			snd.set_length(length);
			holdArray[stepNote.column] = -1;
		}
		if(type != funkin_data_song_importer_StepManiaChartType.DanceSingle) {
			if(stepNote.column < 4) {
				snd.data = stepNote.column + 4;
			} else {
