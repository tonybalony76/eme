			this.difficultyDots.group.members[i].set_x(funkin_ui_freeplay_FreeplayState.CUTOUT_WIDTH * funkin_ui_freeplay_FreeplayState.DJ_POS_MULTI + (this.difficultyDots.x + 30 * curDot - shiftAmt));
			this.difficultyDots.group.members[i].set_y(funkin_ui_freeplay_FreeplayState.DEFAULT_DOTS_GROUP_POS[1] + 30 * curRow);
			++curDot;
