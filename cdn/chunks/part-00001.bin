		var curDot = 0;
		var _g = 0;
		var _g1 = this.difficultyDots.group.members.length;
		while(_g < _g1) {
			var i = _g++;
			var targetState = funkin_ui_freeplay_DotState.SELECTED;
			var targetType = funkin_ui_freeplay_DotType.NORMAL;
			var diffId = this.difficultyDots.group.members[i].difficultyId;
			this.difficultyDots.group.members[i].important = false;
			if(i == index) {
				targetState = funkin_ui_freeplay_DotState.SELECTED;
			} else if(i == prevIndex) {
				targetState = funkin_ui_freeplay_DotState.DESELECTING;
			} else {
				targetState = funkin_ui_freeplay_DotState.DESELECTED;
