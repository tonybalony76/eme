funkin_save_Save.loadFromSlot = function(slot) {
	haxe_Log.trace("[SAVE] Loading save from slot " + slot + "...",{ fileName : "source/funkin/save/Save.hx", lineNumber : 766, className : "funkin.save.Save", methodName : "loadFromSlot"});
	flixel_FlxG.save.bind("Funkin" + slot,"FunkinCrew");
	switch(flixel_FlxG.save.status._hx_index) {
	case 0:
		haxe_Log.trace("[SAVE] Save data in slot " + slot + " is empty, checking for legacy save data...",{ fileName : "source/funkin/save/Save.hx", lineNumber : 771, className : "funkin.save.Save", methodName : "loadFromSlot"});
		var _g = funkin_save_Save.system.fetchLegacySaveData();
		switch(_g._hx_index) {
		case 0:
			haxe_Log.trace("[SAVE] Found legacy save data, converting...",{ fileName : "source/funkin/save/Save.hx", lineNumber : 780, className : "funkin.save.Save", methodName : "loadFromSlot"});
			var gameSave = funkin_save_migrator_SaveDataMigrator.migrateFromLegacy(_g.v);
			flixel_FlxG.save.mergeData(gameSave.data,true);
			return gameSave;
		case 1:
			haxe_Log.trace("[SAVE] No legacy save data found.",{ fileName : "source/funkin/save/Save.hx", lineNumber : 775, className : "funkin.save.Save", methodName : "loadFromSlot"});
			var gameSave = new funkin_save_Save();
			flixel_FlxG.save.mergeData(gameSave.data,true);
			return gameSave;
		}
		break;
	case 1:
		haxe_Log.trace("[SAVE] Loaded existing save data in slot " + slot + ".",{ fileName : "source/funkin/save/Save.hx", lineNumber : 792, className : "funkin.save.Save", methodName : "loadFromSlot"});
		var gameSave = funkin_save_migrator_SaveDataMigrator.migrate(flixel_FlxG.save.data);
		flixel_FlxG.save.mergeData(gameSave.data,true);
		return gameSave;
	case 2:
		return funkin_save_Save.handleSaveDataError(slot);
	case 3:
		return funkin_save_Save.handleSaveDataError(slot);
	case 4:
		return funkin_save_Save.handleSaveDataError(slot);
	}
};
funkin_save_Save.handleSaveDataError = function(slot) {
	var msg = "There was an error loading your save data in slot " + slot + ".";
	msg += "\nPlease report this issue to the developers.";
	funkin_util_WindowUtil.showError("Save Data Failure",msg);
	var nextSlot = slot + 1;
	if(nextSlot > 1000) {
		throw haxe_Exception.thrown("End of save data slots. Can't load any more.");
	}
	return funkin_save_Save.loadFromSlot(nextSlot);
};
funkin_save_Save.debug_queryBadSaveData = function() {
	var firstBadSaveData = funkin_save_Save.querySlotRange(1000,1100);
	if(firstBadSaveData > 0) {
		haxe_Log.trace("[SAVE] Found bad save data in slot " + firstBadSaveData + "!",{ fileName : "source/funkin/save/Save.hx", lineNumber : 821, className : "funkin.save.Save", methodName : "debug_queryBadSaveData"});
		haxe_Log.trace("We should look into recovery...",{ fileName : "source/funkin/save/Save.hx", lineNumber : 822, className : "funkin.save.Save", methodName : "debug_queryBadSaveData"});
		haxe_Log.trace(JSON.stringify(funkin_save_Save.fetchFromSlotRaw(firstBadSaveData)),{ fileName : "source/funkin/save/Save.hx", lineNumber : 823, className : "funkin.save.Save", methodName : "debug_queryBadSaveData"});
	}
};
funkin_save_Save.fetchFromSlotRaw = function(slot) {
	var targetSaveData = new flixel_util_FlxSave();
	targetSaveData.bind("Funkin" + slot,"FunkinCrew");
	if(targetSaveData.isEmpty()) {
		return null;
	}
	return targetSaveData.data;
};
funkin_save_Save.querySlot = function(slot) {
	var targetSaveData = new flixel_util_FlxSave();
	targetSaveData.bind("Funkin" + slot,"FunkinCrew");
	switch(targetSaveData.status._hx_index) {
	case 0:
		return false;
	case 1:
		return true;
	case 2:
		return false;
	case 3:
		return false;
	case 4:
		return false;
	}
};
funkin_save_Save.querySlotRange = function(start,end) {
	var _g = start;
	while(_g < end) {
		var i = _g++;
		if(funkin_save_Save.querySlot(i)) {
			return i;
		}
	}
	return -1;
};
funkin_save_Save.saveToNewgrounds = function() {
	if(funkin_save_Save._instance == null) {
		return;
	}
	haxe_Log.trace("[SAVE] Saving Save Data to Newgrounds...",{ fileName : "source/funkin/save/Save.hx", lineNumber : 907, className : "funkin.save.Save", methodName : "saveToNewgrounds"});
	funkin_api_newgrounds_NGSaveSlot.get_instance().save(funkin_save_Save._instance.data);
};
funkin_save_Save.loadFromNewgrounds = function(onFinish) {
	haxe_Log.trace("[SAVE] Loading Save Data from Newgrounds...",{ fileName : "source/funkin/save/Save.hx", lineNumber : 913, className : "funkin.save.Save", methodName : "loadFromNewgrounds"});
	funkin_api_newgrounds_NGSaveSlot.get_instance().load(function(data) {
		flixel_FlxG.save.bind("Funkin" + 1,"FunkinCrew");
		if(flixel_FlxG.save.status != flixel_util_FlxSaveStatus.EMPTY) {
			var backupSlot = funkin_save_Save.system.archiveBadSaveData(flixel_FlxG.save.data);
			haxe_Log.trace("[SAVE] Backed up current save data in case of emergency to " + backupSlot + "!",{ fileName : "source/funkin/save/Save.hx", lineNumber : 922, className : "funkin.save.Save", methodName : "loadFromNewgrounds"});
		}
		flixel_FlxG.save.erase();
		flixel_FlxG.save.bind("Funkin" + 1,"FunkinCrew");
		var gameSave = funkin_save_migrator_SaveDataMigrator.migrate(data);
		flixel_FlxG.save.mergeData(gameSave.data,true);
		funkin_save_Save._instance = gameSave;
		onFinish();
	},function(error) {
		var msg = "There was an error loading your save data from Newgrounds.";
		msg = "There was an error loading your save data from Newgrounds." + ("\n" + io_newgrounds_CallErrorTools.toString(error));
		msg += "\nAre you sure you are connected to the internet?";
		funkin_util_WindowUtil.showError("Newgrounds Save Slot Failure",msg);
	});
};
