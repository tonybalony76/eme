			var stepStop = funkin_data_song_importer_StepManiaImporter.getStepStopAtBeat(beat,stepStops);
			var b = tp.startBeat;
			var startTime = tp.startTimestamp;
			if(stepStop != null) {
				if(stepStop.startBeat > tp.startBeat) {
					b = stepStop.startBeat;
					startTime = stepStop.startTimestamp + stepStop.duration;
