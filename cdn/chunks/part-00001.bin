		rect.x = rect.x * camera.totalScaleX - 0.5 * camera.width * (camera.scaleX - camera.initialZoom) * flixel_FlxG.scaleMode.scale.x + flixel_FlxG.game.get_x();
		rect.y = rect.y * camera.totalScaleY - 0.5 * camera.height * (camera.scaleY - camera.initialZoom) * flixel_FlxG.scaleMode.scale.y + flixel_FlxG.game.get_y();
