	,favoriteSong: function() {
		var _gthis = this;
		var selectedCapsule = this.get_currentCapsule();
		var targetSong = selectedCapsule != null ? selectedCapsule.freeplayData : null;
		if(targetSong != null) {
			if(targetSong.toggleFavorite()) {
				selectedCapsule.favIcon.set_visible(true);
				selectedCapsule.favIconBlurred.set_visible(true);
				selectedCapsule.favIcon.animation.play("fav");
				selectedCapsule.favIconBlurred.animation.play("fav");
				funkin_audio_FunkinSound.playOnce(funkin_Paths.sound("fav"),1);
				selectedCapsule.checkClip();
				selectedCapsule.set_selected(true);
				this.uiStateMachine.transition(funkin_ui_UIState.Interacting);
				selectedCapsule.doLerp = false;
				flixel_tweens_FlxTween.tween(selectedCapsule,{ y : selectedCapsule.y - 5},0.1,{ ease : flixel_tweens_FlxEase.expoOut});
				flixel_tweens_FlxTween.tween(selectedCapsule,{ y : selectedCapsule.y + 5},0.1,{ ease : flixel_tweens_FlxEase.expoIn, startDelay : 0.1, onComplete : function(_) {
