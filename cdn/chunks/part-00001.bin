			var indices = [];
			var _g = 0;
			var _g1 = pressArray.length;
			while(_g < _g1) {
				var i = _g++;
				if(pressArray[i]) {
					indices.push(i);
				}
			}
		}
		this.comboPopUps.displayRating(daRating);
