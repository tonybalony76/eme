	}
	,checkNewChar: function() {
		var _gthis = this;
		if(this.nonLocks.length > 0) {
			this.selectTimer.start(2,function(_) {
				_gthis.unLock();
			});
		} else {
			if(funkin_util_tools_MapTools.size(this.availableChars) > 1) {
				funkin_api_newgrounds_Medals.award(83655);
			}
			funkin_audio_FunkinSound.playMusic("stayFunky",{ startingVolume : 1, overrideExisting : true, restartTrack : true, onLoad : function() {
				_gthis.allowInput = true;
				_gthis.gfChill.analyzer = new funkin_vis_dsp_SpectralAnalyzer(flixel_FlxG.sound.music._channel.__audioSource,7,0.1);
			}});
		}
	}
	,grpIcons: null
	,grpHitboxes: null
	,grpXSpread: null
	,grpYSpread: null
	,nonLocks: null
	,initLocks: function() {
		this.add(this.grpIcons);
		var _g = 0;
		while(_g < 9) {
			var i = _g++;
			var tmp;
			if(this.availableChars.h.hasOwnProperty(i)) {
				var tmp1 = this.availableChars.h[i];
				tmp = funkin_data_freeplay_player_PlayerRegistry.get_instance().isCharacterSeen(tmp1 != null ? tmp1 : funkin_util_Constants.DEFAULT_CHARACTER);
			} else {
				tmp = false;
			}
			if(tmp) {
				var tmp2 = this.availableChars.h[i];
				var temp = new funkin_ui_PixelatedIcon(0,0);
				temp.setCharacter(tmp2 != null ? tmp2 : funkin_util_Constants.DEFAULT_CHARACTER);
				temp.setGraphicSize(128,128);
				temp.updateHitbox();
				temp.ID = 0;
				this.grpIcons.add(temp);
			} else {
				var tmp3 = this.availableChars.h[i];
				var player = funkin_data_freeplay_player_PlayerRegistry.get_instance().fetchEntry(tmp3 != null ? tmp3 : funkin_util_Constants.DEFAULT_CHARACTER);
				var tmp4 = player != null ? player.isUnlocked() : null;
				if(this.availableChars.h.hasOwnProperty(i) && (tmp4 != null && tmp4)) {
					this.nonLocks.push(i);
				}
				var temp1 = new funkin_ui_charSelect_Lock(0,0,i,{ swfMode : true, uniqueInCache : true});
				temp1.ID = 1;
				this.grpIcons.add(temp1);
			}
			var hitTemp = new flixel_FlxObject(this.grpIcons.group.members[i].x,this.grpIcons.group.members[i].y,86,86);
			hitTemp.set_active(false);
			var this1 = hitTemp.scrollFactor;
			this1.set_x(0);
			this1.set_y(0);
			this.grpHitboxes.add(hitTemp);
		}
		this.updateIconPositions();
		var this1 = this.grpIcons.scrollFactor;
		this1.set_x(0);
		this1.set_y(0);
	}
	,unLock: function() {
		var _gthis = this;
		var index = this.nonLocks[0];
		this.pressedSelect = true;
		var copy = 3;
		var yThing = -1;
		while(index + 1 > copy) {
			++yThing;
			copy += 3;
		}
		var xThing = (copy - index - 2) * -1;
		this.cursorY = yThing;
		this.cursorX = xThing;
		this.selectSound.play(true);
		this.nonLocks.shift();
		this.selectTimer.start(0.5,function(_) {
			var lock = _gthis.grpIcons.group.members[index];
			lock.anim.play("unlock");
			lock.anim.onFrameChange.add(function(animName,frame,index) {
				if(frame == 40) {
					_gthis.playerChillOut.anim.play("death");
				}
			});
			_gthis.unlockSound.set_volume(0.7);
			_gthis.unlockSound.play(true);
			lock.anim.onFinish.addOnce(function(_) {
				var char;
				var tmp = _gthis.availableChars.h[index];
				char = tmp != null ? tmp : funkin_util_Constants.DEFAULT_CHARACTER;
				_gthis.get_camera().flash(-1,0.1);
				_gthis.playerChill.anim.play("unlock");
				_gthis.playerChill.set_visible(true);
				var id = _gthis.grpIcons.group.members.indexOf(lock);
				_gthis.nametag.switchChar(char);
				_gthis.gfChill.switchGF(char);
				_gthis.gfChill.set_visible(true);
				var icon = new funkin_ui_PixelatedIcon(0,0);
				icon.setCharacter(char);
				icon.setGraphicSize(128,128);
				icon.updateHitbox();
				_gthis.grpIcons.insert(id,icon);
				_gthis.grpIcons.remove(lock,true);
				icon.ID = 0;
				_gthis.bopPlay = true;
				_gthis.updateIconPositions();
				_gthis.playerChillOut.anim.onFinish.addOnce(function(_) {
					if(_ == "death") {
						_gthis.playerChillOut.set_visible(false);
						_gthis.playerChillOut.switchChar(char);
					}
				});
				funkin_api_newgrounds_Medals.award(83655);
				funkin_save_Save.get_instance().addCharacterSeen(char);
				if(_gthis.nonLocks.length == 0) {
					_gthis.pressedSelect = false;
					_gthis.curChar = char;
					var _this = _gthis.staticSound;
					_this.cleanup(_this.autoDestroy,true);
					funkin_audio_FunkinSound.playMusic("stayFunky",{ startingVolume : 1, overrideExisting : true, restartTrack : true, onLoad : function() {
						_gthis.allowInput = true;
						_gthis.gfChill.analyzer = new funkin_vis_dsp_SpectralAnalyzer(flixel_FlxG.sound.music._channel.__audioSource,7,0.1);
					}});
				} else {
					_gthis.playerChill.anim.onFinish.addOnce(function(_) {
						_gthis.unLock();
					});
				}
			});
			_gthis.playerChill.set_visible(false);
			var tmp = _gthis.availableChars.h[index];
			_gthis.playerChill.switchChar(tmp != null ? tmp : funkin_util_Constants.DEFAULT_CHARACTER);
			_gthis.playerChillOut.set_visible(true);
		});
	}
	,updateIconPositions: function() {
		this.grpIcons.set_x(this.cutoutSize + 450);
		this.grpIcons.set_y(120);
		var _this = this.grpIcons.group.members;
		var _g_current = 0;
		while(_g_current < _this.length) {
			var _g_value = _this[_g_current];
			var _g_key = _g_current++;
			var posY = Math.floor(_g_key / 3);
			_g_value.set_x(_g_key % 3 * this.grpXSpread);
			_g_value.set_y(posY * this.grpYSpread);
			_g_value.set_x(_g_value.x + this.grpIcons.x);
			_g_value.set_y(_g_value.y + this.grpIcons.y);
		}
		var _this = this.grpHitboxes.members;
		var _g_current = 0;
		while(_g_current < _this.length) {
			var _g_value = _this[_g_current];
			var _g_key = _g_current++;
			var posY = Math.floor(_g_key / 3);
			_g_value.set_x(_g_key % 3 * this.grpXSpread);
			_g_value.set_y(posY * this.grpYSpread);
			_g_value.set_x(_g_value.x + (this.grpIcons.x + 20));
			_g_value.set_y(_g_value.y + (this.grpIcons.y + 20));
		}
	}
	,goToFreeplay: function() {
		var _gthis = this;
		this.allowInput = false;
		this.autoFollow = false;
		flixel_tweens_FlxTween.tween(this.cursors,{ alpha : 0},0.8,{ ease : flixel_tweens_FlxEase.expoOut});
		flixel_tweens_FlxTween.tween(this.barthing,{ y : this.barthing.y + 80},0.8,{ ease : flixel_tweens_FlxEase.backIn});
		flixel_tweens_FlxTween.tween(this.nametag,{ y : this.nametag.y + 80},0.8,{ ease : flixel_tweens_FlxEase.backIn});
		flixel_tweens_FlxTween.tween(this.dipshitBacking,{ y : this.dipshitBacking.y + 210},0.8,{ ease : flixel_tweens_FlxEase.backIn});
		flixel_tweens_FlxTween.tween(this.chooseDipshit,{ y : this.chooseDipshit.y + 200},0.8,{ ease : flixel_tweens_FlxEase.backIn});
		flixel_tweens_FlxTween.tween(this.dipshitBlur,{ y : this.dipshitBlur.y + 220},0.8,{ ease : flixel_tweens_FlxEase.backIn});
		var _this = this.grpIcons.group.members;
		var _g_current = 0;
		while(_g_current < _this.length) {
			var _g_value = _this[_g_current];
			++_g_current;
			flixel_tweens_FlxTween.tween(_g_value,{ y : _g_value.y + 300},0.8,{ ease : flixel_tweens_FlxEase.backIn});
		}
		flixel_FlxG.camera.follow(this.camFollow,flixel_FlxCameraFollowStyle.LOCKON);
		flixel_tweens_FlxTween.cancelTweensOf(this.transitionGradient);
		flixel_tweens_FlxTween.cancelTweensOf(this.fadeShader);
		flixel_tweens_FlxTween.cancelTweensOf(this.camFollow);
		flixel_tweens_FlxTween.tween(this.transitionGradient,{ y : -150},0.8,{ ease : flixel_tweens_FlxEase.backIn});
		this.fadeShader.fade(1.0,0,0.8,{ ease : flixel_tweens_FlxEase.quadIn});
