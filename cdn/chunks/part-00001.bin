			this.playSingAnimation(event.note.noteData.data % 4,true);
		} else if(event.note.noteData.getMustHitNote() && this.characterType == funkin_play_character_CharacterType.GF) {
			this.playComboDropAnimation(event.comboCount);
		}
	}
	,onNoteHoldDrop: function(event) {
		funkin_play_stage_Bopper.prototype.onNoteHoldDrop.call(this,event);
		if(event.eventCanceled) {
			return;
		}
