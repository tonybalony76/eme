			this.playSingAnimation(event.holdNote.noteData.data % 4,true);
		} else if(!event.holdNote.noteData.getMustHitNote() && this.characterType == funkin_play_character_CharacterType.DAD) {
			this.playSingAnimation(event.holdNote.noteData.data % 4,true);
		} else if(event.holdNote.noteData.getMustHitNote() && event.isComboBreak && this.characterType == funkin_play_character_CharacterType.GF) {
