	,goodNoteHit: function(note,input) {
		var a = funkin_input_PreciseInputManager.getCurrentTimestamp();
		var b = input.timestamp;
		var high = a.high - b.high | 0;
		if(haxe_Int32.ucompare(a.low,b.low) < 0) {
			--high;
			high = high | 0;
		}
		var inputLatencyMs = funkin_util_tools_Int64Tools.toFloat(new haxe__$Int64__$_$_$Int64(high,a.low - b.low | 0)) / funkin_util_Constants.NS_PER_MS;
		var diff = funkin_Conductor.get_instance().songPosition - note.noteData.time;
		var totalDiff = diff;
		if(diff < 0) {
			totalDiff = diff + inputLatencyMs;
		} else {
			totalDiff = diff - inputLatencyMs;
		}
		var noteDiff = totalDiff | 0;
		var score = funkin_play_scoring_Scoring.scoreNote(noteDiff,"PBOT1");
		var daRating = funkin_play_scoring_Scoring.judgeNote(noteDiff,"PBOT1");
		var healthChange = 0.0;
		var isComboBreak = false;
		switch(daRating) {
		case "bad":
			healthChange = funkin_util_Constants.HEALTH_BAD_BONUS;
			isComboBreak = funkin_util_Constants.JUDGEMENT_BAD_COMBO_BREAK;
			break;
		case "good":
			healthChange = funkin_util_Constants.HEALTH_GOOD_BONUS;
			isComboBreak = funkin_util_Constants.JUDGEMENT_GOOD_COMBO_BREAK;
			break;
		case "shit":
			healthChange = funkin_util_Constants.HEALTH_SHIT_BONUS;
			isComboBreak = funkin_util_Constants.JUDGEMENT_SHIT_COMBO_BREAK;
			break;
		case "sick":
			healthChange = funkin_util_Constants.HEALTH_SICK_BONUS;
			isComboBreak = funkin_util_Constants.JUDGEMENT_SICK_COMBO_BREAK;
			break;
		}
		var event = new funkin_modding_events_HitNoteScriptEvent(note,healthChange,score,daRating,isComboBreak,note.scoreable ? funkin_Highscore.tallies.combo + 1 : funkin_Highscore.tallies.combo,noteDiff,daRating == "sick");
		this.dispatchEvent(event);
		if(event.eventCanceled) {
			return;
		}
		this.playerStrumline.hitNote(note,!event.isComboBreak);
		if(event.doesNotesplash) {
			this.playerStrumline.playNoteSplash(note.noteData.data % 4);
		}
		if(note.get_isHoldNote() && note.holdNoteSprite != null) {
			this.playerStrumline.playNoteHoldCover(note.holdNoteSprite);
		}
		if(this.vocals != null) {
			this.vocals.set_playerVolume(this.playerVocalsVolume);
		}
		if(note.scoreable) {
			funkin_Highscore.tallies.totalNotesHit++;
			this.applyScore(event.score,event.judgement,event.healthChange,event.isComboBreak);
			this.popUpScore(event.judgement);
		}
	}
