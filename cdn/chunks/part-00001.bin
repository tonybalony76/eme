	,addCharacterSeen: function(character) {
		if(this.data.unlocks.charactersSeen.indexOf(character) == -1) {
			haxe_Log.trace(funkin_util_AnsiUtil.apply(funkin_util_AnsiUtil.apply(" SAVE ","\x1B[1m"),"\x1B[48;2;0;238;255m") + ("Seen character \"" + character + "\" in Character Select!"),{ fileName : "source/funkin/save/Save.hx", lineNumber : 407, className : "funkin.save.Save", methodName : "addCharacterSeen"});
