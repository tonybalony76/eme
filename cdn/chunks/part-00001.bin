			y = this.textField.get_textHeight();
		}
		if(y < 2) {
			y = 2;
		}
		var _g = 0;
		var _g1 = this.textField.get_numLines();
		while(_g < _g1) {
			var line = _g++;
			var lineY = 2 + this.getLineY(line);
			var lineOffset = this.textField.getLineOffset(line);
			var lineHeight = this.textField.getLineMetrics(line).height;
			if(y >= lineY && y <= lineY + lineHeight) {
