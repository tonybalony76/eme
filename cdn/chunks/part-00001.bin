		case "slidein":
			if(_gthis.hasAnimation("slidein idle point")) {
				_gthis.anim.play("slidein idle point",true);
			} else {
				_gthis.anim.play("idle",true);
				_gthis.anim._curAnim.looped = true;
			}
			break;
		case "cannot select Label":case "slidein idle point":case "unlock":
			_gthis.anim.play("idle",true);
