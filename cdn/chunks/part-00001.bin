			}
			this.setSelection(this._selectionIndex,this._caretIndex);
			this.restartCaretTimer();
			break;
		case 1:
			if(this._caretIndex < this.text.length) {
				this._caretIndex++;
			}
			if(!shiftKey) {
				this._selectionIndex = this._caretIndex;
			}
			this.setSelection(this._selectionIndex,this._caretIndex);
			this.restartCaretTimer();
			break;
		case 2:
			var lineIndex = this.getLineIndexOfChar(this._caretIndex);
			if(lineIndex > 0) {
				this._caretIndex = this.getCharIndexOnDifferentLine(this._caretIndex,lineIndex - 1);
			}
			if(!shiftKey) {
				this._selectionIndex = this._caretIndex;
			}
			this.setSelection(this._selectionIndex,this._caretIndex);
			this.restartCaretTimer();
			break;
		case 3:
			var lineIndex = this.getLineIndexOfChar(this._caretIndex);
			if(lineIndex < this.textField.get_numLines() - 1) {
				this._caretIndex = this.getCharIndexOnDifferentLine(this._caretIndex,lineIndex + 1);
			}
			if(!shiftKey) {
				this._selectionIndex = this._caretIndex;
			}
			this.setSelection(this._selectionIndex,this._caretIndex);
			this.restartCaretTimer();
			break;
		case 4:
			this._caretIndex = 0;
			if(!shiftKey) {
				this._selectionIndex = this._caretIndex;
			}
			this.setSelection(this._selectionIndex,this._caretIndex);
			this.restartCaretTimer();
			break;
		case 5:
			this._caretIndex = this.text.length;
			if(!shiftKey) {
				this._selectionIndex = this._caretIndex;
			}
			this.setSelection(this._selectionIndex,this._caretIndex);
			this.restartCaretTimer();
			break;
		case 6:
			this._caretIndex = this.textField.getLineOffset(this.getLineIndexOfChar(this._caretIndex));
			if(!shiftKey) {
				this._selectionIndex = this._caretIndex;
			}
			this.setSelection(this._selectionIndex,this._caretIndex);
			this.restartCaretTimer();
			break;
		case 7:
			var lineIndex = this.getLineIndexOfChar(this._caretIndex);
