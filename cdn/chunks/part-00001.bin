		this._regenCaretSize = false;
		var lineHeight = this.get_height() - 4;
		if(this.text.length > 0) {
			lineHeight = this.textField.getLineMetrics(0).height;
		}
		this._caret.makeGraphic(this.caretWidth,lineHeight | 0);
		this.clipSprite(this._caret);
	}
	,updateSelection: function(keepScroll) {
		if(keepScroll == null) {
			keepScroll = false;
