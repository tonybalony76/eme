	this.digitalThreshold = 0.5;
	this.rawRight = -1;
	this.rawLeft = -1;
	this.rawDown = -1;
	this.rawUp = -1;
	this.x = x;
	this.y = y;
	if(settings != null) {
		if(settings.mode != null) {
			this.mode = settings.mode;
		}
		if(settings.up != null) {
			this.rawUp = settings.up;
		}
		if(settings.down != null) {
			this.rawDown = settings.down;
		}
		if(settings.left != null) {
			this.rawLeft = settings.left;
		}
		if(settings.right != null) {
			this.rawRight = settings.right;
		}
		if(settings.threshold != null) {
			this.digitalThreshold = settings.threshold;
		}
	}
