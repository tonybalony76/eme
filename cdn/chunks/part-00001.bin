			this.restartCaretTimer();
			break;
		case 9:
			while(this._caretIndex < this.text.length && flixel_text_FlxInputText.DELIMITERS.indexOf(this.text.charAt(this._caretIndex)) == -1) this._caretIndex++;
			while(this._caretIndex < this.text.length && flixel_text_FlxInputText.DELIMITERS.indexOf(this.text.charAt(this._caretIndex)) != -1) this._caretIndex++;
			if(!shiftKey) {
				this._selectionIndex = this._caretIndex;
			}
			this.setSelection(this._selectionIndex,this._caretIndex);
