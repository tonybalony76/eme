			funkin_play_cutscene_VideoCutscene.pauseVideo();
		} else if(funkin_Preferences.get_autoPause()) {
			funkin_play_cutscene_VideoCutscene.resumeVideo();
		}
		funkin_ui_MusicBeatSubState.prototype.onFocus.call(this);
	}
	,onFocusLost: function() {
		if(funkin_Preferences.get_autoPause()) {
			funkin_play_cutscene_VideoCutscene.pauseVideo();
		}
		if(!this.get_isGamePaused() && funkin_Preferences.get_autoPause()) {
			if(this.currentConversation != null) {
				this.pause(funkin_play_PauseMode.Conversation,true);
			} else if(funkin_play_cutscene_VideoCutscene.isPlaying()) {
				this.pause(funkin_play_PauseMode.Cutscene,true);
			} else {
				this.pause(null,true);
			}
		}
		funkin_ui_MusicBeatSubState.prototype.onFocusLost.call(this);
	}
	,reloadAssets: function() {
		this.performCleanup();
