	,pause: function(mode,lostFocus) {
		if(lostFocus == null) {
			lostFocus = false;
		}
		if(mode == null) {
			mode = funkin_play_PauseMode.Standard;
		}
		var _gthis = this;
		if(!this.mayPauseGame || this.justUnpaused || this.get_isGamePaused() || this.isPlayerDying) {
			return;
		}
		switch(mode._hx_index) {
		case 3:
			this.preparePauseUI();
			this.openPauseSubState(funkin_play_PauseMode.Conversation,this.camPause,lostFocus,function() {
				var tmp = _gthis.currentConversation;
				if(tmp != null) {
					tmp.pauseMusic();
				}
			});
			break;
		case 4:
			this.preparePauseUI();
			this.openPauseSubState(funkin_play_PauseMode.Cutscene,this.camPause,lostFocus,function() {
				funkin_play_cutscene_VideoCutscene.pauseVideo();
			});
			break;
		default:
			if(!this.isInCountdown || this.isInCutscene) {
				return;
			}
			funkin_play_Countdown.pauseCountdown();
			this.preparePauseUI();
			var event = new funkin_modding_events_PauseScriptEvent(flixel_FlxG.random.float(0,100) < 0.1);
			this.dispatchEvent(event);
			if(!event.eventCanceled) {
				this.persistentUpdate = false;
				this.persistentDraw = true;
				if(!this.get_isSubState() && event.gitaroo) {
					if(this.currentStage != null) {
						this.remove(this.currentStage);
					}
					var nextState = flixel_util_typeLimit_NextState.fromMaker(function() {
						return new funkin_play_GitarooPause(funkin_play_PlayState.lastParams);
					});
					var stateOnCall = flixel_FlxG.game._state;
					flixel_FlxG.game._state.startOutro(function() {
						if(flixel_FlxG.game._state == stateOnCall) {
							flixel_FlxG.game._nextState = nextState;
						} else {
							flixel_FlxG.log.advanced("`onOutroComplete` was called after the state was switched. This will be ignored",flixel_system_debug_log_LogStyle.WARNING,true,{ fileName : "flixel/FlxG.hx", lineNumber : 395, className : "flixel.FlxG", methodName : "switchState"});
						}
					});
				} else {
					flixel_math_FlxBasePoint.pool.get().set(0,0)._inPool = false;
					if(this.currentStage != null && this.currentStage.getBoyfriend() != null) {
						this.currentStage.getBoyfriend().getScreenPosition();
					}
					this.openPauseSubState(this.get_isChartingMode() ? funkin_play_PauseMode.Charting : funkin_play_PauseMode.Standard,this.camPause,lostFocus);
				}
			}
		}
	}
	,preparePauseUI: function() {
	}
	,openPauseSubState: function(mode,cam,lostFocus,onPause) {
