			funkin_modding_events_ScriptEventDispatcher.callEvent(this.backingCard,event);
		}
		if(this.dj != null) {
			funkin_modding_events_ScriptEventDispatcher.callEvent(this.dj,event);
		}
	}
	,createFreeplayDJ: function(x,y,characterId) {
		var tmp = this.currentCharacter;
		var tmp1 = tmp != null ? tmp.getFreeplayDJData() : null;
		var tmp = tmp1 != null ? tmp1.renderType : null;
		var renderType = StringTools.trim(tmp != null ? tmp : "animateatlas").toLowerCase();
		var tmp = this.currentCharacter;
		var tmp1 = tmp != null ? tmp.getFreeplayDJData() : null;
		var tmp = tmp1 != null ? tmp1.scriptClass : null;
		var scriptClass = StringTools.trim(tmp != null ? tmp : "");
		switch(renderType) {
		case "animateatlas":
			this.dj = scriptClass != "" ? funkin_ui_freeplay_dj_ScriptedAnimateAtlasFreeplayDJ.init(scriptClass,x,y,characterId) : new funkin_ui_freeplay_dj_AnimateAtlasFreeplayDJ(x,y,characterId);
			break;
		case "multisparrow":
			this.dj = scriptClass != "" ? funkin_ui_freeplay_dj_ScriptedMultiSparrowFreeplayDJ.init(scriptClass,x,y,characterId) : new funkin_ui_freeplay_dj_MultiSparrowFreeplayDJ(x,y,characterId);
			break;
		case "packer":
			this.dj = scriptClass != "" ? funkin_ui_freeplay_dj_ScriptedPackerFreeplayDJ.init(scriptClass,x,y,characterId) : new funkin_ui_freeplay_dj_PackerFreeplayDJ(x,y,characterId);
			break;
		case "sparrow":
			this.dj = scriptClass != "" ? funkin_ui_freeplay_dj_ScriptedSparrowFreeplayDJ.init(scriptClass,x,y,characterId) : new funkin_ui_freeplay_dj_SparrowFreeplayDJ(x,y,characterId);
			break;
		}
	}
	,currentFilter: null
	,currentFilteredSongs: null
	,generateSongList: function(filterStuff,force,onlyIfChanged,noJumpIn) {
		if(noJumpIn == null) {
			noJumpIn = false;
		}
		if(onlyIfChanged == null) {
			onlyIfChanged = true;
		}
		if(force == null) {
			force = false;
		}
		var _gthis = this;
		var tempSongs = this.songs;
		if(filterStuff != null) {
			tempSongs = this.sortSongs(tempSongs,filterStuff);
		}
		var _g = [];
		var _g1 = 0;
		var _g2 = tempSongs;
		while(_g1 < _g2.length) {
			var v = _g2[_g1];
			++_g1;
			var tempSongs;
			if(v == null) {
				tempSongs = true;
			} else {
				var characterVariations = v.get_data().getVariationsByCharacter(_gthis.currentCharacter);
				tempSongs = v.get_data().listDifficulties(null,characterVariations).indexOf(_gthis.currentDifficulty) != -1;
			}
			if(tempSongs) {
				_g.push(v);
			}
		}
		if(onlyIfChanged) {
			if(funkin_util_tools_ArrayTools.isEqualUnordered(_g,this.currentFilteredSongs)) {
				var _g1 = 0;
				var _g2 = this.grpCapsules.members;
				while(_g1 < _g2.length) {
					var capsule = _g2[_g1];
					++_g1;
					if(!noJumpIn) {
						capsule.initPosition(flixel_FlxG.width,0);
						capsule.initJumpIn(0,force);
					}
				}
				return;
			}
		}
		this.currentFilter = filterStuff;
		this.currentFilteredSongs = _g;
		this.curSelected = 0;
		this.grpCapsules.killMembers();
		var randomCapsule = this.grpCapsules.recycle(funkin_ui_freeplay_SongMenuItem);
		randomCapsule.initRandom(this.styleData);
		randomCapsule.onConfirm = function() {
			_gthis.capsuleOnOpenRandom(randomCapsule);
		};
		if(this.fromCharSelect || this.forceSkipIntro || noJumpIn) {
			randomCapsule.forcePosition();
		} else {
			randomCapsule.initJumpIn(0,force);
		}
		var hsvShader = new funkin_graphics_shaders_HSVShader();
		randomCapsule.set_hsvShader(hsvShader);
		this.grpCapsules.add(randomCapsule);
		var _g1 = 0;
		var _g2 = _g.length;
		while(_g1 < _g2) {
			var i = _g1++;
			var tempSong = _g[i];
			if(tempSong == null) {
				continue;
			}
			var funnyMenu = [this.grpCapsules.recycle(funkin_ui_freeplay_SongMenuItem)];
			funnyMenu[0].initPosition(flixel_FlxG.width,0);
			funnyMenu[0].initData(tempSong,this.styleData,i + 1);
			funnyMenu[0].onConfirm = (function(funnyMenu) {
				return function() {
					_gthis.capsuleOnOpenDefault(funnyMenu[0]);
				};
			})(funnyMenu);
			funnyMenu[0].set_y(funnyMenu[0].intendedY(i + 1) + 10);
			funnyMenu[0].targetPos.set_x(funnyMenu[0].x);
			funnyMenu[0].ID = i;
			funnyMenu[0].capsule.set_alpha(0.5);
			funnyMenu[0].set_hsvShader(hsvShader);
			funnyMenu[0].newText.animation._curAnim.set_curFrame(45 - i * 4 % 45);
			if(this.fromCharSelect || this.forceSkipIntro || noJumpIn) {
				funnyMenu[0].forcePosition();
			} else {
				funnyMenu[0].initJumpIn(0,force);
			}
			this.grpCapsules.add(funnyMenu[0]);
		}
		this.rememberSelection();
		this.changeSelection();
		this.refreshCapsuleDisplays();
		this.dispatchEvent(new funkin_modding_events_CapsuleScriptEvent("DIFFICULTY_SWITCH",this.get_currentCapsule(),this.currentDifficulty,this.currentVariation));
	}
	,sortSongs: function(songsToFilter,songFilter) {
		var filterAlphabetically = function(a,b) {
			var tmp = a != null ? a.get_data().get_songName() : null;
			var tmp1 = b != null ? b.get_data().get_songName() : null;
			return funkin_util_SortUtil.alphabetically(tmp != null ? tmp : "",tmp1 != null ? tmp1 : "");
		};
		switch(songFilter.filterType) {
		case "ALL":
			break;
		case "FAVORITE":
			var _g = [];
			var _g1 = 0;
			var _g2 = songsToFilter;
			while(_g1 < _g2.length) {
				var v = _g2[_g1];
				++_g1;
				if(v == null ? true : v.get_isFav()) {
					_g.push(v);
				}
			}
			songsToFilter = _g;
			break;
		case "REGEXP":
			var filterRegexp = new EReg("^[" + Std.string(songFilter.filterData) + "].*","i");
			var _g = [];
			var _g1 = 0;
			var _g2 = songsToFilter;
			while(_g1 < _g2.length) {
				var v = _g2[_g1];
				++_g1;
				if(v == null ? true : filterRegexp.match(v.get_data().get_songName())) {
					_g.push(v);
				}
			}
			songsToFilter = _g;
			_g.sort(filterAlphabetically);
			break;
		case "STARTSWITH":
			var _g = [];
			var _g1 = 0;
			var _g2 = songsToFilter;
			while(_g1 < _g2.length) {
				var v = _g2[_g1];
				++_g1;
				var songsToFilter1;
				if(v == null) {
					songsToFilter1 = true;
				} else {
					var songsToFilter2 = v.get_data().get_songName().toLowerCase();
					var tmp = songFilter.filterData;
					songsToFilter1 = StringTools.startsWith(songsToFilter2,tmp != null ? tmp : "");
