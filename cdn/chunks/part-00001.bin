					break;
				case 12:
					this.deleteCoolText();
					break;
				case 13:
					this.addMoreText("Friday");
					break;
				case 14:
					if(this.curWacky[0] == "trending") {
						this.addMoreText("Nigth");
					} else {
						this.addMoreText("Night");
					}
					break;
				case 15:
