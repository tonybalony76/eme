				if(tpIndex == stepTimingPoints.length) {
					var cts = 0;
					while(spIndex < stepStopPoints.length) {
						var sp = stepStopPoints[spIndex];
						sp.startTimestamp = prevTp.startTimestamp + (sp.startBeat - prevTp.startBeat) / (prevTp.bpm / 60) + cts;
