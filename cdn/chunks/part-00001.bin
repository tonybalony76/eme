funkin_save_SaveSystem.prototype = {
	flush: function() {
		flixel_FlxG.save.flush();
	}
	,clearSlot: function(slot) {
		flixel_FlxG.save.bind("Funkin" + slot,"FunkinCrew");
		if(flixel_FlxG.save.status == flixel_util_FlxSaveStatus.EMPTY) {
			return new funkin_save_Save();
		}
		funkin_save_Save.system.archiveBadSaveData(flixel_FlxG.save.data);
		flixel_FlxG.save.erase();
		return new funkin_save_Save();
	}
	,fetchLegacySaveData: function() {
		haxe_Log.trace("[SAVE] Checking for legacy save data...",{ fileName : "source/funkin/save/SaveSystem.hx", lineNumber : 38, className : "funkin.save.SaveSystem", methodName : "fetchLegacySaveData"});
		var legacySave = new flixel_util_FlxSave();
		legacySave.bind("funkin","ninjamuffin99");
		if(legacySave.isEmpty()) {
			haxe_Log.trace("[SAVE] No legacy save data found.",{ fileName : "source/funkin/save/SaveSystem.hx", lineNumber : 44, className : "funkin.save.SaveSystem", methodName : "fetchLegacySaveData"});
			return haxe_ds_Option.None;
		} else {
