				var targetNote = thx_Arrays.find(notesInDirection,function(note) {
					return !note.lowPriority;
				});
				if(targetNote == null) {
					targetNote = notesInDirection[0];
				}
				if(targetNote == null) {
					continue;
				}
				this.goodNoteHit(targetNote,input);
				HxOverrides.remove(notesInDirection,targetNote);
