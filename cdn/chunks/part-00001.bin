			this._caret.setPosition(this.x + this.getCaretOffsetX(),this.y + 2);
		} else {
			var boundaries = this.getCharBoundaries(this._caretIndex - 1);
			if(boundaries != null) {
				this._caret.setPosition(this.x + boundaries.get_right() - this.textField.get_scrollH(),this.y + boundaries.y - this.getScrollVOffset());
			} else {
				boundaries = this.getCharBoundaries(this._caretIndex);
				if(boundaries != null) {
					this._caret.setPosition(this.x + boundaries.x - this.textField.get_scrollH(),this.y + boundaries.y - this.getScrollVOffset());
				} else {
					this._caret.setPosition(this.x + this.getCaretOffsetX(),this.y + 2 + this.getLineY(this.getLineIndexOfChar(this._caretIndex)) - this.getScrollVOffset());
