		var cacheScrollH = this.textField.get_scrollH();
		var cacheScrollV = this.textField.get_scrollV();
		this.textField.setSelection(this._selectionIndex,this._caretIndex);
		this._regen = true;
		if(keepScroll) {
			this.set_scrollH(cacheScrollH);
			this.set_scrollV(cacheScrollV);
		} else if(this.textField.get_scrollH() != cacheScrollH || this.textField.get_scrollV() != cacheScrollV) {
			this.onScrollChange.dispatch(this.textField.get_scrollH(),this.textField.get_scrollV());
		}
	}
	,updateSelectionBoxes: function() {
		if(this.textField == null || this._selectionBoxes == null) {
			return;
		}
		var visibleLines = this.textField.get_bottomScrollV() - this.textField.get_scrollV() + 1;
		while(this._selectionBoxes.length > visibleLines) {
			var box = this._selectionBoxes.pop();
			if(box != null) {
				box.destroy();
