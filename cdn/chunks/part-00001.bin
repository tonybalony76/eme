			}
			this.onEnter.dispatch(this.text);
			break;
		case 1:
			if(!this.editable) {
				return;
			}
			if(this._selectionIndex == this._caretIndex && this._caretIndex > 0) {
				this._selectionIndex = this._caretIndex - 1;
			}
			if(this._selectionIndex != this._caretIndex) {
				this.replaceSelectedText("");
				this._selectionIndex = this._caretIndex;
				this.onTextChange.dispatch(this.text,"backspace");
			} else {
				this.restartCaretTimer();
			}
			break;
		case 2:
			if(!this.editable) {
				return;
			}
			if(this._selectionIndex == this._caretIndex && this._caretIndex < this.text.length) {
				this._selectionIndex = this._caretIndex + 1;
			}
			if(this._selectionIndex != this._caretIndex) {
				this.replaceSelectedText("");
				this._selectionIndex = this._caretIndex;
				this.onTextChange.dispatch(this.text,"delete");
			} else {
				this.restartCaretTimer();
			}
			break;
		case 3:
			if(this._caretIndex != this._selectionIndex && !this.textField.get_displayAsPassword()) {
				lime_system_Clipboard.set_text(this.text.substring(this._caretIndex,this._selectionIndex));
			}
			break;
		case 4:
			if(this.editable && this._caretIndex != this._selectionIndex && !this.textField.get_displayAsPassword()) {
				lime_system_Clipboard.set_text(this.text.substring(this._caretIndex,this._selectionIndex));
				this.replaceSelectedText("");
			}
			break;
		case 5:
			if(this.editable && lime_system_Clipboard.get_text() != null) {
