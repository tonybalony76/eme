					_gthis.uiStateMachine.transition(funkin_ui_UIState.Idle);
				}});
			} else {
				selectedCapsule.favIcon.animation.play("fav",true,true,9);
				selectedCapsule.favIconBlurred.animation.play("fav",true,true,9);
				funkin_audio_FunkinSound.playOnce(funkin_Paths.sound("unfav"),1);
				new flixel_util_FlxTimer().start(0.2,function(_) {
					selectedCapsule.favIcon.set_visible(false);
					selectedCapsule.favIconBlurred.set_visible(false);
					selectedCapsule.checkClip();
					selectedCapsule.set_selected(true);
				});
				this.uiStateMachine.transition(funkin_ui_UIState.Interacting);
				selectedCapsule.doLerp = false;
				flixel_tweens_FlxTween.tween(selectedCapsule,{ y : selectedCapsule.y + 5},0.1,{ ease : flixel_tweens_FlxEase.expoOut});
				flixel_tweens_FlxTween.tween(selectedCapsule,{ y : selectedCapsule.y - 5},0.1,{ ease : flixel_tweens_FlxEase.expoIn, startDelay : 0.1, onComplete : function(_) {
					selectedCapsule.doLerp = true;
					_gthis.uiStateMachine.transition(funkin_ui_UIState.Idle);
				}});
			}
		}
