		holdArray = [-1,-1,-1,-1,-1,-1,-1,-1];
	} else {
		haxe_Log.trace("[WARN] Unknown StepMania chart type when converting notes.",{ fileName : "source/funkin/data/song/importer/StepManiaImporter.hx", lineNumber : 502, className : "funkin.data.song.importer.StepManiaImporter", methodName : "convertStepNotes"});
