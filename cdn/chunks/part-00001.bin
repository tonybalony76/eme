		if(event.note.noteData.getMustHitNote() && this.characterType == funkin_play_character_CharacterType.BF) {
			if(this.curNoteKind != null) {
				if(!this.curNoteKind.noanim) {
					var tmp = this.curNoteKind;
					this.playSingAnimation(event.note.noteData.data % 4,false,tmp != null ? tmp.suffix : null);
					this.holdTimer = 0;
				}
			} else {
				this.playSingAnimation(event.note.noteData.data % 4,false);
				this.holdTimer = 0;
			}
		} else if(!event.note.noteData.getMustHitNote() && this.characterType == funkin_play_character_CharacterType.DAD) {
			if(this.curNoteKind != null) {
				if(!this.curNoteKind.noanim) {
					var tmp = this.curNoteKind;
					this.playSingAnimation(event.note.noteData.data % 4,false,tmp != null ? tmp.suffix : null);
					this.holdTimer = 0;
				}
