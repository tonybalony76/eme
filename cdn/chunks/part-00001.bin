	,regenBackground: function() {
		if(!this.background) {
			return;
		}
		this._regenBackground = false;
		if(this.fieldBorderThickness > 0) {
			this._fieldBorderSprite.makeGraphic((this.get_fieldWidth() | 0) + this.fieldBorderThickness * 2,(this.get_fieldHeight() | 0) + this.fieldBorderThickness * 2,this.fieldBorderColor);
			this._fieldBorderSprite.set_visible(true);
		} else {
			this._fieldBorderSprite.set_visible(false);
		}
		if((this.backgroundColor >> 24 & 255) > 0) {
			this._backgroundSprite.makeGraphic(this.get_fieldWidth() | 0,this.get_fieldHeight() | 0,this.backgroundColor);
			this._backgroundSprite.set_visible(true);
		} else {
			this._backgroundSprite.set_visible(false);
		}
