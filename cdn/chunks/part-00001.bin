	haxe_Log.trace(funkin_util_AnsiUtil.apply(funkin_util_AnsiUtil.apply(" SAVE ","\x1B[1m"),"\x1B[48;2;0;238;255m") + " Loading save...",{ fileName : "source/funkin/save/Save.hx", lineNumber : 50, className : "funkin.save.Save", methodName : "load"});
